{
  "$defs": {
    "CanvasGroup": {
      "description": "A presentation-only frame that can contain workflow nodes.",
      "properties": {
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "color": {
          "default": "#22d3ee",
          "maxLength": 32,
          "minLength": 4,
          "title": "Color",
          "type": "string"
        },
        "height": {
          "default": 280,
          "exclusiveMinimum": 80,
          "maximum": 4000,
          "title": "Height",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "未命名分组",
          "maxLength": 128,
          "title": "Name",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Node Ids",
          "type": "array"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "width": {
          "default": 480,
          "exclusiveMinimum": 120,
          "maximum": 4000,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "CanvasGroup",
      "type": "object"
    },
    "CanvasMetadata": {
      "description": "Persisted editor-only objects; execution ignores this section.",
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/CanvasGroup"
          },
          "maxItems": 100,
          "title": "Groups",
          "type": "array"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/CanvasNote"
          },
          "maxItems": 200,
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "CanvasMetadata",
      "type": "object"
    },
    "CanvasNote": {
      "description": "A presentation-only sticky note attached to a workflow canvas.",
      "properties": {
        "color": {
          "default": "#fbbf24",
          "maxLength": 32,
          "minLength": 4,
          "title": "Color",
          "type": "string"
        },
        "height": {
          "default": 140,
          "exclusiveMinimum": 64,
          "maximum": 1200,
          "title": "Height",
          "type": "number"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "text": {
          "default": "",
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        },
        "width": {
          "default": 240,
          "exclusiveMinimum": 120,
          "maximum": 1200,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "CanvasNote",
      "type": "object"
    },
    "EdgeSpec": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Handle"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Handle"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "EdgeSpec",
      "type": "object"
    },
    "NodeSpec": {
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeType"
            },
            {
              "type": "string"
            }
          ],
          "title": "Type"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "NodeSpec",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "start",
        "agent",
        "tool",
        "condition",
        "switch",
        "rag",
        "human",
        "iteration",
        "http",
        "code",
        "subworkflow",
        "end"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "Position": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "VariableType": {
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ],
      "title": "VariableType",
      "type": "string"
    },
    "WorkflowSettings": {
      "properties": {
        "max_loop_iterations": {
          "default": 20,
          "title": "Max Loop Iterations",
          "type": "integer"
        },
        "recursion_limit": {
          "default": 50,
          "title": "Recursion Limit",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "WorkflowSettings",
      "type": "object"
    },
    "WorkflowVariable": {
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/VariableType",
          "default": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "WorkflowVariable",
      "type": "object"
    }
  },
  "properties": {
    "canvas": {
      "$ref": "#/$defs/CanvasMetadata"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/EdgeSpec"
      },
      "title": "Edges",
      "type": "array"
    },
    "name": {
      "default": "未命名工作流",
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeSpec"
      },
      "title": "Nodes",
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/WorkflowSettings"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/WorkflowVariable"
      },
      "title": "Variables",
      "type": "array"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "WorkflowDSL",
  "type": "object"
}
