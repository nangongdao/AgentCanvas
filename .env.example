# ===== AgentCanvas environment configuration =====
# Copy to .env and fill in real values. NEVER commit .env.

# --- Security ---
# development | test | production. Production enforces token auth + Fernet +
# a durable backend-aware checkpointer (SQLite for single-host, PostgreSQL for
# I1) that fails closed instead of degrading and dropping pending approvals.
APP_ENV=development
# C8-3: emit Strict-Transport-Security only behind TLS (production deployments
# behind a TLS-terminating proxy set HSTS_ENABLED=true).
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
LOG_FORMAT=json
OTEL_SERVICE_NAME=agentcanvas-backend
# Optional collector base URL; exports to /v1/traces and /v1/metrics when set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0

# Fernet key for encrypting API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Optional Docker/Kubernetes secret directory. References use
# docker://relative-file and are confined below this absolute directory.
DOCKER_SECRET_DIR=/run/secrets

# disabled keeps local development zero-config. Use token in shared/deployed environments.
AUTH_MODE=disabled
ADMIN_API_TOKEN=
EDITOR_API_TOKEN=
VIEWER_API_TOKEN=
AUTH_SESSION_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000

# --- Workflow collaboration (I1 Phase 6) ---
# Without REDIS_URL presence/soft-lock stay process-local for single-instance
# development. With REDIS_URL the shared Redis hub coordinates multi-API
# replicas; if Redis is configured but unreachable, mutations fail closed
# (read-only) instead of splitting process-local locks.
COLLABORATION_PRESENCE_TTL_SECONDS=30
COLLABORATION_LOCK_TTL_SECONDS=30
COLLABORATION_SWEEP_INTERVAL_SECONDS=5

# Optional OIDC Authorization Code + PKCE login. Configure issuer, client ID,
# and callback URI together. Client secret is optional for public clients.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGIN_REDIRECT_URL=/
OIDC_SCOPES=openid,profile,email
OIDC_DEFAULT_ROLE=viewer
OIDC_HTTP_TIMEOUT_SECONDS=10

# --- Request rate limits (per client, per API process) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_REQUESTS=300
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_EXECUTION_REQUESTS=10
RATE_LIMIT_WEBHOOK_REQUESTS=60
RATE_LIMIT_WORKFLOW_API_REQUESTS=60
RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_INGEST_REQUESTS=10
RATE_LIMIT_RETRIEVAL_REQUESTS=30
RATE_LIMIT_MCP_REQUESTS=30
# Bounds each API process's in-memory client/route buckets.
RATE_LIMIT_MAX_BUCKETS=10000

# --- Request body, concurrency, and operation timeouts (U3-6) ---
REQUEST_BODY_MAX_BYTES=1048576
# Includes multipart framing; the file itself remains capped by RAG_MAX_UPLOAD_BYTES.
UPLOAD_REQUEST_MAX_BYTES=22020096
EXECUTION_MAX_CONCURRENT=8
EXECUTION_REQUEST_TIMEOUT_SECONDS=30
# C8-2: public app runtime (unauthenticated) concurrency guard and timeout.
APP_RUNTIME_MAX_CONCURRENT=4
APP_RUNTIME_TIMEOUT_SECONDS=60
# Per-client send bucket for the unauthenticated app runtime (independent of
# the per-session send budget RATE_LIMIT_APP_RUNTIME_REQUESTS).
RATE_LIMIT_APP_RUNTIME_SEND_REQUESTS=60
# all preserves local single-process operation. Horizontal roles require
# PostgreSQL + Redis and STARTUP_MIGRATIONS=false.
APP_PROCESS_ROLE=all
APP_INSTANCE_ID=
# Optional stable owner ID for a dedicated execution worker. The hostname is
# used when this is empty.
EXECUTION_WORKER_ID=
# Durable worker lease and scheduler knobs.
EXECUTION_WORKER_POLL_SECONDS=0.5
EXECUTION_LEASE_SECONDS=30
EXECUTION_LEASE_MAX_ATTEMPTS=3
EXECUTION_SCHEDULER_POLL_SECONDS=1.0
EXECUTION_SCHEDULER_BATCH_SIZE=100
WORKFLOW_SCHEDULE_POLL_SECONDS=1.0
WORKFLOW_SCHEDULE_BATCH_SIZE=100
# Periodic online knowledge-source scanner and claim lease.
ONLINE_SOURCE_SYNC_POLL_SECONDS=5.0
ONLINE_SOURCE_SYNC_BATCH_SIZE=10
ONLINE_SOURCE_SYNC_LEASE_SECONDS=1800
# Event relay / shared SSE. Without REDIS_URL the relay stays idle and SSE
# falls back to bounded PostgreSQL polling.
EVENT_RELAY_POLL_SECONDS=0.5
EVENT_RELAY_BATCH_SIZE=100
EVENT_STREAM_MAXLEN=10000
# Durable outbound workflow callbacks (scanner, lease, timeout, retries).
WORKFLOW_CALLBACK_POLL_SECONDS=1.0
WORKFLOW_CALLBACK_BATCH_SIZE=100
WORKFLOW_CALLBACK_LEASE_SECONDS=30
WORKFLOW_CALLBACK_DEFAULT_TIMEOUT_SECONDS=10
WORKFLOW_CALLBACK_DEFAULT_MAX_ATTEMPTS=5
WORKFLOW_CALLBACK_DEFAULT_RETRY_DELAY_SECONDS=10

# --- C6-1 execution event retention ---
# execution_events grows unbounded; the retention scheduler deletes detail
# rows past the retention window for executions that reached a terminal state.
# Set RETENTION_DAYS=0 to disable pruning entirely.
EXECUTION_EVENT_RETENTION_DAYS=30
EXECUTION_EVENT_RETENTION_POLL_SECONDS=300
EXECUTION_EVENT_RETENTION_BATCH_SIZE=1000
EXECUTION_EVENT_RETENTION_GRACE_DAYS=7

# --- C7-4 outbound email (organization invitations) ---
# Leave SMTP_HOST empty to disable email: invitation links are then returned
# to the inviting admin in the API response instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=agentcanvas@localhost
SMTP_STARTTLS=true
INVITATION_EXPIRE_DAYS=7

# --- C7-1 usage fact aggregation ---
# Each sweep rewrites the trailing complete UTC days into usage_daily_facts
# (idempotent full-day rewrites). Days older than the lookback window are
# frozen so exported billing history cannot drift when model prices change.
USAGE_FACT_LOOKBACK_DAYS=3
USAGE_FACT_POLL_SECONDS=900

# --- C7-5 tenant data compliance ---
# GRACE_DAYS is the frozen window between a deletion request and the hard
# purge; an org/platform admin may cancel within it. 0 makes the purge due
# immediately after the request.
ORG_DELETION_GRACE_DAYS=30
ORG_DELETION_PURGE_BATCH_SIZE=200
ORG_DELETION_PURGE_POLL_SECONDS=60

MODEL_MAX_CONCURRENT=8
MODEL_MAX_CALLS_PER_EXECUTION=32
MODEL_RATE_LIMIT_CALLS=120
MODEL_RATE_LIMIT_WINDOW_SECONDS=60
MODEL_TIMEOUT_SECONDS=120
CHAT_MAX_CONCURRENT=8
UPLOAD_MAX_CONCURRENT=4
UPLOAD_TIMEOUT_SECONDS=60
INGEST_MAX_CONCURRENT=2
INGEST_TIMEOUT_SECONDS=300
RETRIEVAL_MAX_CONCURRENT=8
RETRIEVAL_TIMEOUT_SECONDS=60
LOGIN_MAX_CONCURRENT=16
LOGIN_TIMEOUT_SECONDS=10
MCP_MAX_CONCURRENT=4
MCP_TIMEOUT_SECONDS=30

# --- Provider/MCP resilience (process-local) ---
MODEL_RESILIENCE_MAX_ATTEMPTS=2
MODEL_RESILIENCE_FAILURE_THRESHOLD=3
MODEL_RESILIENCE_RESET_SECONDS=30
MODEL_RESILIENCE_RETRY_BUDGET=32
MCP_RESILIENCE_MAX_ATTEMPTS=2
MCP_RESILIENCE_FAILURE_THRESHOLD=3
MCP_RESILIENCE_RESET_SECONDS=30
MCP_RESILIENCE_RETRY_BUDGET=32
RESILIENCE_RETRY_WINDOW_SECONDS=60

# --- Default LLM (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: embedding model (defaults to chat provider's base_url) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Knowledge ingestion / retrieval ---
RAG_MAX_UPLOAD_BYTES=20971520
# Batch size 64 / concurrency 4 suit the local CPU fallback. Remote embedding
# APIs can usually take EMBEDDING_CONCURRENCY=8-16 for faster ingestion; watch
# provider rate limits before raising it.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT_SECONDS=60
# Used only for the deterministic local fallback when no embedding API key is set.
LOCAL_EMBEDDING_DIMENSIONS=384
CHROMA_MAX_CONCURRENT=4
VECTOR_MAX_CONCURRENT=4
# I1 Phase 7 multi-instance-safe RAG vectors.
# auto  — Chroma on SQLite single-host; pgvector document_chunks on PostgreSQL
# chroma — force embedded Chroma (single-host only)
# pgvector — require PostgreSQL and database-side cosine ranking
# sql    — portable SQL fallback (SQLite tests; PostgreSQL still uses pgvector)
VECTOR_BACKEND=auto

# --- Database ---
# Shared root for SQLite, checkpoints, uploads, Chroma, and the MCP workspace.
APP_DATA_DIR=
# Keep true only for local `APP_PROCESS_ROLE=all`. Production Compose runs
# explicit migrate/bootstrap services and sets this false for every long-running role.
STARTUP_MIGRATIONS=true
SQLITE_BUSY_TIMEOUT_MS=5000
# WAL durability/throughput tradeoff: OFF | NORMAL | FULL | EXTRA.
SQLITE_SYNCHRONOUS=NORMAL
# Supported drivers are sqlite+aiosqlite and postgresql+asyncpg.
# Horizontal production requires PostgreSQL. The backup CLI selects SQLite's
# online snapshot or PostgreSQL pg_dump/pg_restore based on this URL.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agentcanvas
DATABASE_URL=
# Required only for PostgreSQL restore/drill. It must identify a different,
# empty database and must never point at DATABASE_URL.
PG_RESTORE_TARGET_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# --- Redis (optional; falls back to SQLite memory store when absent) ---
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# Optional Redis AOF directory included by the backup command.
REDIS_AOF_DIR=

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
PYTHONUTF8=1

# --- MCP connection lifecycle ---
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_REAPER_INTERVAL_SECONDS=60
MCP_IDLE_TIMEOUT_SECONDS=600

# Stdio child-process allowlist. Python/Node scripts must also resolve under an allowed root.
MCP_STDIO_ALLOWED_COMMANDS=python,python.exe
# Comma-separated absolute roots; defaults to backend/mcp_servers.
MCP_STDIO_ALLOWED_ROOTS=
# Packages allowed when npx/npm is explicitly added to the command allowlist.
MCP_STDIO_ALLOWED_PACKAGES=

# --- Versioned node plugins ---
# Plugins are discovered from backend/plugins and run in fresh subprocesses.
PLUGIN_ROOT_DIR=
PLUGIN_MAX_INPUT_BYTES=65536
PLUGIN_MAX_OUTPUT_BYTES=65536
PLUGIN_MAX_EVENTS=32

# --- C8-1 process-level sandbox (plugin / code-node subprocesses) ---
# auto       — nsjail, then bwrap, then process_cleanup (first available)
# nsjail     — pin nsjail; degrade to process_cleanup if the binary is absent
# bubblewrap — pin bwrap; degrade to process_cleanup if the binary is absent
# process    — environment cleanup only (no OS isolation; Windows dev fallback)
# none       — opt-out, TESTS ONLY; rejected in production
SANDBOX_BACKEND=auto
# When true, declared plugin permissions (network/filesystem) are mandatory —
# an undeclared access is denied by the sandbox, not merely audited.
SANDBOX_ENFORCE_PERMISSIONS=true
# rlimit-style caps applied to every sandboxed subprocess.
SANDBOX_CPU_TIME_SECONDS=30
SANDBOX_ADDRESS_SPACE_MB=512
SANDBOX_FILE_SIZE_MB=32
SANDBOX_PROCESS_COUNT=16
SANDBOX_OPEN_FILES=64
